[Unit]
Description=Office Clock Display Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi/oclock.git
# Raspbian Jessie ships systemd 215, before LogsDirectory= was added.
ExecStartPre=/bin/mkdir -p /var/log/oclock
ExecStart=/home/pi/oclock.git/oclock -b 0.0.0.0 -p 8080 -l /var/log/oclock/pulsar.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
